# PLR Digital Club — required environment variables
#
# Production: set these in Railway → service → Variables, then REDEPLOY.
# (NEXT_PUBLIC_* values are baked into the client bundle at BUILD time —
# changing them without a fresh build has no effect.)
#
# Local dev: copy this file to plr-members/.env.local and fill in the values.
# Never commit real values; .env* is gitignored.

# ── Supabase (dashboard → Settings → API) ───────────────────────────────────
# Project URL, e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (dashboard → Developers → API keys) ──────────────────────────────
STRIPE_SECRET_KEY=
# Price ID of the $197 lifetime product, e.g. price_xxxxx
STRIPE_PRICE_ID=
# Webhook signing secret for the /api/webhooks/stripe endpoint, whsec_xxxxx
STRIPE_WEBHOOK_SECRET=

# ── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Email address that unlocks /admin for the matching logged-in user
ADMIN_EMAIL=
# Public origin of the site (no trailing slash)
NEXT_PUBLIC_APP_URL=https://plrdigitalclub.com

# ── Optional / infra ────────────────────────────────────────────────────────
# PostgreSQL connection string (drizzle-kit tooling)
# DATABASE_URL=
# PORT=5000
